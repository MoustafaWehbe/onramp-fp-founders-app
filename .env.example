# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API. Drives req.ip, which every
# rate limiter keys on. 0 = trust nothing (correct for local dev and for a
# directly-exposed process). Set to 1 behind a single nginx / ALB / Cloudflare
# layer. Too low and all users share the proxy's IP; too high and a client can
# forge X-Forwarded-For to bypass the limiters entirely.
TRUST_PROXY=0
# Public base URL of the web app used for links in outgoing email
APP_URL=http://localhost:5173

# Authenticated Prometheus-compatible operational metrics (token: 32+ chars).
METRICS_ENABLED=false
METRICS_TOKEN=

# Reviewer privacy/operations retention windows.
REVIEWER_CHALLENGE_RETENTION_HOURS=24
REVIEWER_NETWORK_RETENTION_DAYS=30
REVIEWER_ENGAGEMENT_RETENTION_DAYS=365
REVIEWER_EVENT_RETENTION_DAYS=365

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=raise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-in-production

# OTP
OTP_HMAC_SECRET=change-me-to-a-long-random-secret-in-production

# Signs the short-lived tokens that authorize reviewer page-image reads.
# Falls back to OTP_HMAC_SECRET when unset; set it separately in production.
PAGE_TOKEN_SECRET=change-me-to-a-long-random-secret-in-production

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FP Founders <noreply@yourdomain.com>

# OpenAI
OPENAI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
