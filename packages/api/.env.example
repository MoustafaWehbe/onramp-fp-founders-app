# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Public base URL of the web app — used for links in outgoing email
APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/starter_kit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter_kit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-in-production

# OTP
OTP_HMAC_SECRET=change-me-to-a-long-random-secret-in-production

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FP Founders <noreply@yourdomain.com>

# OpenAI
OPENAI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com