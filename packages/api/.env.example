# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Public base URL of the web app used for links in outgoing email
APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_kit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter_kit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-in-production

# OTP
OTP_HMAC_SECRET=change-me-to-a-long-random-secret-in-production

# Signs the short-lived tokens that authorize reviewer page-image reads.
# Falls back to OTP_HMAC_SECRET when unset; set it separately in production.
PAGE_TOKEN_SECRET=change-me-to-a-long-random-secret-in-production

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FP Founders <noreply@yourdomain.com>

# Document vault storage
# Production: set SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY plus the bucket(s) below.
# Local/dev: leave blank to fall back to packages/api/.uploads + Redis upload tokens.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Profile photos are small and non-sensitive, so unlike the documents bucket
# above this one should be PUBLIC (read) in Supabase — avatars are served
# directly by URL, never through short-lived signed links.
SUPABASE_AVATARS_BUCKET=avatars

# LlamaParse (required to parse PDF/DOCX/XLSX/PPTX; TXT works without it)
# Without this key, non-TXT uploads will mark the version as failed with PARSE_UNAVAILABLE.
LLAMA_CLOUD_API_KEY=
# LlamaCloud keys are region-locked. Leave blank for a US-org key (default
# https://api.cloud.llamaindex.ai). Set to https://api.cloud.eu.llamaindex.ai
# for an EU-org key — using the wrong one fails with a 401 "Invalid API Key.
# Please check your region", which looks like a bad key but isn't one.
LLAMA_CLOUD_BASE_URL=

# OpenAI (embeddings for document chunks — versions still become ready if this is unset,
# but chunk vectors will not be persisted until embeddings jobs succeed)
OPENAI_API_KEY=
# Chat and analysis routes are disabled until this flag is enabled. Existing
# document embeddings still run when OPENAI_API_KEY is set.
AI_ENABLED=false
AI_CHAT_MODEL=gpt-4.1-mini
AI_ANALYSIS_MODEL=gpt-4.1
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2000
AI_ANALYSIS_MAX_OUTPUT_TOKENS=8000
AI_MAX_TOOL_ROUNDS=4
AI_RETRIEVAL_RESULT_COUNT=8
AI_RETRIEVAL_TOKEN_BUDGET=4500
AI_MIN_RETRIEVAL_SCORE=0.2
AI_MAX_RETRIES=1
# AI capacity and cost controls. These are per authenticated user/startup,
# separate from the general API limiter.
AI_MESSAGES_PER_MINUTE=20
AI_CONCURRENT_STREAMS_PER_USER=2
AI_ANALYSES_PER_STARTUP_PER_DAY=20
AI_QUEUED_ANALYSES_PER_STARTUP=4
# Archived chat content is retained until you set a documented policy. Set a
# positive number of days to delete archived conversations and their cascaded
# messages/citations/artifacts; 0 keeps automatic deletion disabled.
AI_CHAT_RETENTION_DAYS=0
# Google OAuth (Sign in with Google ID-token flow, no secret needed)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Calendar/Gmail integration optional. Leave all three unset to run
# without it; set all three together or the app refuses to start.
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/integrations/google/callback
# 64-char hex string (32 bytes) for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
