{
  "name": "@starter-kit/api",
  "version": "0.0.1",
  "private": true,
  "main": "./server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "worker": "tsx watch src/jobs/workers/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/src/jobs/workers/index.js",
    "test": "jest --config jest.config.js --coverage --passWithNoTests",
    "lint": "eslint 'src/**/*.ts' 'app.ts' 'server.ts'",
    "clean": "rm -rf dist",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "js-yaml": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.5.0",
    "openai": "^4.67.0",
    "resend": "^6.16.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
