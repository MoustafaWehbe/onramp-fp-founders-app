{
  "name": "@starter-kit/api",
  "version": "0.0.1",
  "private": true,
  "main": "./server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "worker": "tsx watch src/jobs/workers/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/src/jobs/workers/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --coverage --passWithNoTests",
    "eval:ai": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --runInBand tests/unit/ai-evaluation.service.test.ts tests/unit/ai-rubric.test.ts",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:backfill-pages": "tsx scripts/backfill-page-images.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.9.0",
    "gpt-tokenizer": "^3.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "js-yaml": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "node-cron": "^4.5.0",
    "openai": "^4.67.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.16.0",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  }
}
