generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── CORE ─────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String    @unique
  passwordHash        String?   @map("password_hash")
  avatarUrl           String?   @map("avatar_url")
  authProvider        String    @default("local") @map("auth_provider")
  googleId            String?   @unique @map("google_id")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastActiveStartupId String?   @map("last_active_startup_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  lastActiveStartup      Startup?                @relation("LastActiveStartup", fields: [lastActiveStartupId], references: [id])
  createdStartups        Startup[]               @relation("CreatedStartups")
  memberships            StartupMember[]         @relation("MemberUser")
  sentInvites            StartupMember[]         @relation("InvitedBy")
  refreshTokens          RefreshToken[]
  passwordResets         PasswordReset[]
  reviewerInvitations    ReviewerInvitation[]
  interactionLogs        InteractionLog[]
  createdDocuments       Document[]
  uploadedVersions       DocumentVersion[]
  aiChatSessions         AiChatSession[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  pipelineStageEvents    PipelineStageEvent[]
  tasks                  Task[]
  authoredInvestorNotes  StartupInvestor[]       @relation("InvestorNotesAuthor")
  editedInvestorNotes    StartupInvestor[]       @relation("InvestorNotesEditor")
  commitmentStatusEvents CommitmentStatusEvent[]
  googleConnection       GoogleConnection?
  conversationsCreated   Conversation[]

  @@map("users")
}

// ─── INTEGRATIONS ─────────────────────────────────────────────────────────────

model GoogleConnection {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // The Google account actually connected may differ from the sign-in email.
  googleEmail String @map("google_email")

  // OAuth scopes granted at consent time, e.g. "calendar.events gmail.send".
  scopes String @map("scopes")

  // AES-256-GCM ciphertext (iv + auth tag + ciphertext, base64) never the raw token.
  refreshTokenCipher String @map("refresh_token_cipher")

  status String @default("active")

  calendarSyncEnabled Boolean @default(true) @map("calendar_sync_enabled")

  // Calendar's incremental sync cursor. Null forces a full resync.
  calendarSyncToken String?   @map("calendar_sync_token")
  lastSyncedAt      DateTime? @map("last_synced_at")
  lastError         String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_connections")
}

model Startup {
  id           String   @id @default(uuid())
  name         String
  description  String?
  industry     String?
  website      String?
  fundingStage String?  @map("funding_stage")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator                User                    @relation("CreatedStartups", fields: [createdBy], references: [id])
  lastActiveUsers        User[]                  @relation("LastActiveStartup")
  members                StartupMember[]
  roles                  Role[]
  startupInvestors       StartupInvestor[]
  pipeline               Pipeline[]
  fundraisingRounds      FundraisingRound[]
  commitments            Commitment[]
  commitmentStatusEvents CommitmentStatusEvent[]
  documents              Document[]
  aiAnalyses             AiAnalysis[]
  aiChatSessions         AiChatSession[]
  reviewerInvitations    ReviewerInvitation[]
  reviewerComments       ReviewerComment[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  pipelineStageEvents    PipelineStageEvent[]
  tasks                  Task[]
  conversations          Conversation[]
  conversationMembers    ConversationMember[]
  messages               Message[]
  messageMentions        MessageMention[]
  messageReactions       MessageReaction[]
  messageAttachments     MessageAttachment[]

  @@map("startups")
}

model StartupMember {
  id              String    @id @default(uuid())
  startupId       String    @map("startup_id")
  userId          String?   @map("user_id")
  roleId          String    @map("role_id")
  status          String    @default("pending")
  invitedEmail    String?   @map("invited_email")
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  invitedBy       String?   @map("invited_by")
  joinedAt        DateTime? @map("joined_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User?   @relation("MemberUser", fields: [userId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])
  inviter User?   @relation("InvitedBy", fields: [invitedBy], references: [id])

  ownedDeals    Pipeline[] @relation("PipelineOwner")
  assignedTasks Task[]     @relation("TaskAssignee")

  conversationMemberships ConversationMember[]
  messagesSent            Message[]            @relation("MessageSender")
  chatMentions            MessageMention[]     @relation("MentionedMember")
  messageReactions        MessageReaction[]

  @@unique([startupId, userId])
  @@unique([startupId, invitedEmail])
  @@unique([startupId, id])
  @@map("startup_members")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model PendingRegistration {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  otpHash      String   @map("otp_hash")
  otpExpiresAt DateTime @map("otp_expires_at")
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String?   @map("family_id")
  replacedById String?   @map("replaced_by_id")
  deviceInfo   String?   @map("device_info")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy     RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replacedTokens RefreshToken[] @relation("TokenRotation")

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id           String   @id @default(uuid())
  startupId    String   @map("startup_id")
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  startup         Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  members         StartupMember[]
  rolePermissions RolePermission[]

  @@unique([startupId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── REVIEWER SYSTEM ──────────────────────────────────────────────────────────

model ReviewerInvitation {
  id                String   @id @default(uuid())
  startupId         String   @map("startup_id")
  startupInvestorId String?  @map("startup_investor_id")
  reviewerName      String?  @map("reviewer_name")
  email             String
  tokenHash         String   @unique @map("token_hash")
  status            String   @default("pending")
  expiresAt         DateTime @map("expires_at")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  startup         Startup                      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupInvestor StartupInvestor?             @relation(fields: [startupInvestorId], references: [id])
  creator         User                         @relation(fields: [createdBy], references: [id])
  documents       ReviewerInvitationDocument[]
  sessions        ReviewerSession[]

  @@map("reviewer_invitations")
}

model ReviewerInvitationDocument {
  id           String @id @default(uuid())
  invitationId String @map("invitation_id")
  documentId   String @map("document_id")

  invitation ReviewerInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([invitationId, documentId])
  @@map("reviewer_invitation_documents")
}

model ReviewerSession {
  id                    String    @id @default(uuid())
  invitationId          String    @map("invitation_id")
  verificationCodeHash  String?   @map("verification_code_hash")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  verifiedAt            DateTime? @map("verified_at")
  accessedAt            DateTime? @map("accessed_at")
  ipAddress             String?   @map("ip_address")
  userAgent             String?   @map("user_agent")

  invitation ReviewerInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  comments   ReviewerComment[]

  @@map("reviewer_sessions")
}

model ReviewerComment {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  startupId   String   @map("startup_id")
  documentId  String?  @map("document_id")
  chunkId     String?  @map("chunk_id")
  commentText String   @map("comment_text")
  createdAt   DateTime @default(now()) @map("created_at")

  session  ReviewerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startup  Startup         @relation(fields: [startupId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id])
  chunk    DocumentChunk?  @relation(fields: [chunkId], references: [id])

  @@map("reviewer_comments")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model StartupInvestor {
  id                        String    @id @default(uuid())
  startupId                 String    @map("startup_id")
  fullName                  String    @map("full_name")
  email                     String?
  ventureFirm               String?   @map("venture_firm")
  investorType              String?   @map("investor_type")
  sectorFocus               String?   @map("sector_focus")
  investmentStagePreference String?   @map("investment_stage_preference")
  linkedinUrl               String?   @map("linkedin_url")
  notes                     String?
  notesCreatedAt            DateTime? @map("notes_created_at")
  notesCreatedBy            String?   @map("notes_created_by")
  notesUpdatedAt            DateTime? @map("notes_updated_at")
  notesUpdatedBy            String?   @map("notes_updated_by")
  source                    String?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  startup             Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  notesAuthor         User?                @relation("InvestorNotesAuthor", fields: [notesCreatedBy], references: [id], onDelete: SetNull)
  notesEditor         User?                @relation("InvestorNotesEditor", fields: [notesUpdatedBy], references: [id], onDelete: SetNull)
  pipeline            Pipeline[]           @relation("PipelineInvestor")
  interactionLogs     InteractionLog[]
  commitments         Commitment[]         @relation("CommitmentInvestor")
  reviewerInvitations ReviewerInvitation[]
  mentions            MessageMention[]

  @@unique([startupId, email])
  @@unique([startupId, id])
  @@map("startup_investors")
}

model Pipeline {
  id                    String   @id @default(uuid())
  startupId             String   @map("startup_id")
  roundId               String   @map("round_id")
  startupInvestorId     String   @map("startup_investor_id")
  stage                 String   @default("sourced")
  expectedAmount        Decimal? @map("expected_amount")
  probabilityPercentage Int?     @map("probability_percentage")
  ownerId               String?  @map("owner_id")
  priority              String?
  investorFitScore      Int?     @map("investor_fit_score")
  isLead                Boolean  @default(false) @map("is_lead")
  sortOrder             Float    @default(0) @map("sort_order")
  stageChangedAt        DateTime @default(now()) @map("stage_changed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  startup         Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  round           FundraisingRound     @relation("PipelineRound", fields: [roundId, startupId], references: [id, startupId], onDelete: Restrict)
  startupInvestor StartupInvestor      @relation("PipelineInvestor", fields: [startupInvestorId, startupId], references: [id, startupId], onDelete: Cascade)
  owner           StartupMember?       @relation("PipelineOwner", fields: [ownerId, startupId], references: [id, startupId], onDelete: NoAction)
  interactionLogs InteractionLog[]
  commitments     Commitment[]         @relation("CommitmentPipeline")
  stageEvents     PipelineStageEvent[]
  tasks           Task[]
  mentions        MessageMention[]

  @@unique([roundId, startupInvestorId])
  @@unique([id, startupInvestorId])
  @@unique([id, startupInvestorId, roundId])
  @@unique([startupId, id])
  @@index([startupId, roundId, stage, sortOrder])
  @@index([startupId, roundId, stageChangedAt])
  @@map("pipeline")
}

model PipelineStageEvent {
  id         String   @id @default(uuid())
  startupId  String   @map("startup_id")
  roundId    String   @map("round_id")
  pipelineId String   @map("pipeline_id")
  fromStage  String?  @map("from_stage")
  toStage    String   @map("to_stage")
  reason     String?
  changedBy  String?  @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  startup  Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  round    FundraisingRound @relation("PipelineStageEventRound", fields: [roundId, startupId], references: [id, startupId], onDelete: Restrict)
  pipeline Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  actor    User?            @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([startupId, createdAt])
  @@index([startupId, roundId, createdAt])
  @@index([pipelineId, createdAt])
  @@map("pipeline_stage_events")
}

model Task {
  id          String    @id @default(uuid())
  startupId   String    @map("startup_id")
  pipelineId  String    @map("pipeline_id")
  title       String
  description String?
  status      String    @default("open")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date")
  assigneeId  String?   @map("assignee_id")
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  startup  Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  pipeline Pipeline         @relation(fields: [pipelineId, startupId], references: [id, startupId], onDelete: Restrict)
  assignee StartupMember?   @relation("TaskAssignee", fields: [assigneeId, startupId], references: [id, startupId], onDelete: NoAction)
  creator  User             @relation(fields: [createdBy], references: [id])
  mentions MessageMention[]

  @@unique([startupId, id])
  @@index([startupId, pipelineId, status])
  @@index([startupId, status, dueDate])
  @@map("tasks")
}

model InteractionLog {
  id                  String    @id @default(uuid())
  startupInvestorId   String    @map("startup_investor_id")
  pipelineId          String?   @map("pipeline_id")
  createdBy           String    @map("created_by")
  type                String
  subject             String?
  description         String?
  interactionDate     DateTime? @map("interaction_date")
  nextFollowupDate    DateTime? @map("next_followup_date")
  followupCompletedAt DateTime? @map("followup_completed_at")
  source              String    @default("manual")
  externalId          String?   @map("external_id")
  gmailThreadId       String?   @map("gmail_thread_id")
  emailMessageId      String?   @map("email_message_id")
  editedByUser        Boolean   @default(false) @map("edited_by_user")

  createdAt DateTime @default(now()) @map("created_at")

  startupInvestor StartupInvestor @relation(fields: [startupInvestorId], references: [id], onDelete: Cascade)
  pipeline        Pipeline?       @relation(fields: [pipelineId, startupInvestorId], references: [id, startupInvestorId])
  creator         User            @relation(fields: [createdBy], references: [id])

  @@unique([startupInvestorId, externalId])
  @@map("interaction_logs")
}

// ─── FINANCIAL ────────────────────────────────────────────────────────────────

model FundraisingRound {
  id                      String    @id @default(uuid())
  startupId               String    @map("startup_id")
  roundName               String    @map("round_name")
  targetAmount            Decimal?  @map("target_amount")
  minimumTicketSize       Decimal?  @map("minimum_ticket_size")
  equityOfferedPercentage Decimal?  @map("equity_offered_percentage")
  currency                String    @default("USD")
  status                  String    @default("active")
  firstCloseDate          DateTime? @map("first_close_date")
  targetCloseDate         DateTime? @map("target_close_date")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  startup             Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  pipeline            Pipeline[]           @relation("PipelineRound")
  pipelineStageEvents PipelineStageEvent[] @relation("PipelineStageEventRound")
  commitments         Commitment[]         @relation("CommitmentRound")
  mentions            MessageMention[]

  @@unique([startupId, id])
  @@map("fundraising_rounds")
}

model Commitment {
  id                String    @id @default(uuid())
  startupId         String    @map("startup_id")
  startupInvestorId String    @map("startup_investor_id")
  pipelineId        String    @map("pipeline_id")
  roundId           String    @map("round_id")
  amount            Decimal?
  status            String    @default("soft_circled")
  expectedCloseDate DateTime? @map("expected_close_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  startup         Startup                 @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupInvestor StartupInvestor         @relation("CommitmentInvestor", fields: [startupInvestorId, startupId], references: [id, startupId], onDelete: Cascade)
  pipeline        Pipeline                @relation("CommitmentPipeline", fields: [pipelineId, startupInvestorId, roundId], references: [id, startupInvestorId, roundId])
  round           FundraisingRound        @relation("CommitmentRound", fields: [roundId, startupId], references: [id, startupId])
  statusEvents    CommitmentStatusEvent[]

  @@index([startupId, roundId, status])
  @@map("commitments")
}

model CommitmentStatusEvent {
  id           String   @id @default(uuid())
  startupId    String   @map("startup_id")
  commitmentId String   @map("commitment_id")
  // Null for the first event the commitment being recorded.
  fromStatus   String?  @map("from_status")
  toStatus     String   @map("to_status")
  changedBy    String?  @map("changed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  startup    Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([startupId, createdAt])
  @@index([commitmentId, createdAt])
  @@map("commitment_status_events")
}

// ─── DOCUMENT VAULT ───────────────────────────────────────────────────────────

model Document {
  id           String   @id @default(uuid())
  startupId    String   @map("startup_id")
  title        String
  documentType String   @map("document_type")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  startup            Startup                      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  creator            User                         @relation(fields: [createdBy], references: [id])
  versions           DocumentVersion[]
  reviewerDocs       ReviewerInvitationDocument[]
  reviewerComments   ReviewerComment[]
  aiChatSessions     AiChatSession[]              @relation("AiChatSessionDocument")
  mentions           MessageMention[]
  messageAttachments MessageAttachment[]

  @@unique([startupId, id])
  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  versionNumber Int      @map("version_number")
  isCurrent     Boolean  @default(false) @map("is_current")
  fileUrl       String   @map("file_url")
  fileSize      Int?     @map("file_size")
  summary       String?
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader   User            @relation(fields: [uploadedBy], references: [id])
  chunks     DocumentChunk[]
  aiAnalyses AiAnalysis[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentChunk {
  id                String                       @id @default(uuid())
  documentVersionId String                       @map("document_version_id")
  chunkIndex        Int                          @map("chunk_index")
  content           String
  embedding         Unsupported("vector(1536)")?
  tokenCount        Int?                         @map("token_count")
  pageNumber        Int?                         @map("page_number")
  sectionLabel      String?                      @map("section_label")
  createdAt         DateTime                     @default(now()) @map("created_at")

  documentVersion  DocumentVersion   @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  reviewerComments ReviewerComment[]

  @@unique([documentVersionId, chunkIndex])
  @@map("document_chunks")
}

// ─── AI INSIGHTS ──────────────────────────────────────────────────────────────

model AiAnalysis {
  id                    String   @id @default(uuid())
  startupId             String   @map("startup_id")
  documentVersionId     String   @map("document_version_id")
  overallScore          Int?     @map("overall_score")
  narrativeScore        Int?     @map("narrative_score")
  marketValidationScore Int?     @map("market_validation_score")
  financialScore        Int?     @map("financial_score")
  summaryReport         String?  @map("summary_report")
  status                String   @default("processing")
  createdAt             DateTime @default(now()) @map("created_at")

  startup         Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion   @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  gapAnalyses     AiGapAnalysis[]
  personas        InvestorPersona[]
  aiChatSessions  AiChatSession[]   @relation("AiChatSessionAnalysis")

  @@unique([startupId, id])
  @@map("ai_analyses")
}

model AiGapAnalysis {
  id             String  @id @default(uuid())
  analysisId     String  @map("analysis_id")
  sectionName    String? @map("section_name")
  status         String
  issue          String?
  recommendation String?
  severity       String?

  analysis AiAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("ai_gap_analysis")
}

model InvestorPersona {
  id          String  @id @default(uuid())
  analysisId  String  @map("analysis_id")
  personaName String? @map("persona_name")
  description String?

  analysis  AiAnalysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questions PersonaQuestion[]

  @@map("investor_personas")
}

model PersonaQuestion {
  id           String  @id @default(uuid())
  personaId    String  @map("persona_id")
  questionText String? @map("question_text")

  persona InvestorPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("persona_questions")
}

// ─── AI CHAT ──────────────────────────────────────────────────────────────────

model AiChatSession {
  id         String   @id @default(uuid())
  startupId  String   @map("startup_id")
  userId     String   @map("user_id")
  documentId String?  @map("document_id")
  analysisId String?  @map("analysis_id")
  createdAt  DateTime @default(now()) @map("created_at")

  startup  Startup         @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])
  document Document?       @relation("AiChatSessionDocument", fields: [documentId, startupId], references: [id, startupId])
  analysis AiAnalysis?     @relation("AiChatSessionAnalysis", fields: [analysisId, startupId], references: [id, startupId])
  messages AiChatMessage[]

  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_chat_messages")
}

// ─── TEAM CHAT ────────────────────────────────────────────────────────────────
model Conversation {
  id            String    @id @default(uuid())
  startupId     String    @map("startup_id")
  type          String    @default("channel")
  name          String?
  topic         String?
  dmKey         String?   @map("dm_key")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  startup  Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  creator  User                 @relation(fields: [createdBy], references: [id])
  members  ConversationMember[]
  messages Message[]
  mentions MessageMention[]

  @@unique([startupId, id])
  @@unique([startupId, name])
  @@unique([startupId, dmKey])
  @@index([startupId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(uuid())
  startupId      String   @map("startup_id")
  conversationId String   @map("conversation_id")
  memberId       String   @map("member_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  lastReadSeq BigInt?   @map("last_read_seq")
  lastReadAt  DateTime? @map("last_read_at")

  notifyLevel String    @default("all") @map("notify_level")

  conversation Conversation  @relation(fields: [conversationId, startupId], references: [id, startupId], onDelete: Cascade)
  member       StartupMember @relation(fields: [memberId, startupId], references: [id, startupId], onDelete: Cascade)
  startup      Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId, startupId])
  @@map("conversation_members")
}

model Message {
  id             String  @id @default(uuid())
  startupId      String  @map("startup_id")
  conversationId String  @map("conversation_id")
  seq            BigInt  @default(autoincrement())
  senderId       String? @map("sender_id")
  parentMessageId String? @map("parent_message_id")
  replyCount      Int     @default(0) @map("reply_count")

  body String

  clientNonce String    @map("client_nonce")
  editedAt    DateTime? @map("edited_at")
  deletedAt   DateTime? @map("deleted_at") // tombstone, never a hard delete
  createdAt   DateTime  @default(now()) @map("created_at")

  startup      Startup             @relation(fields: [startupId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId, startupId], references: [id, startupId], onDelete: Cascade)
  sender       StartupMember?      @relation("MessageSender", fields: [senderId, startupId], references: [id, startupId], onDelete: NoAction)
  parent       Message?            @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies      Message[]           @relation("MessageReplies")
  mentions     MessageMention[]
  reactions    MessageReaction[]
  attachments  MessageAttachment[]

  @@unique([startupId, id])
  @@unique([conversationId, clientNonce])
  @@index([conversationId, seq])
  @@index([parentMessageId, seq])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  startupId String   @map("startup_id")
  messageId String   @map("message_id")
  memberId  String   @map("member_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  startup Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  message Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  member  StartupMember @relation(fields: [memberId, startupId], references: [id, startupId], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageAttachment {
  id         String   @id @default(uuid())
  startupId  String   @map("startup_id")
  messageId  String   @map("message_id")
  documentId String   @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  startup  Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId, startupId], references: [id, startupId], onDelete: Cascade)

  @@unique([messageId, documentId])
  @@index([messageId])
  @@map("message_attachments")
}

model MessageMention {
  id             String @id @default(uuid())
  startupId      String @map("startup_id")
  messageId      String @map("message_id")
  conversationId String @map("conversation_id") // denormalized: backlinks skip a join through Message

  // "member" | "investor" | "deal" | "task" | "round" | "document"
  targetType String @map("target_type")

  mentionedMemberId String? @map("mentioned_member_id")
  investorId        String? @map("investor_id")
  pipelineId        String? @map("pipeline_id")
  taskId            String? @map("task_id")
  roundId           String? @map("round_id")
  documentId        String? @map("document_id")

  createdAt DateTime @default(now()) @map("created_at")

  startup         Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  message         Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation    Conversation      @relation(fields: [conversationId, startupId], references: [id, startupId], onDelete: Cascade)
  mentionedMember StartupMember?    @relation("MentionedMember", fields: [mentionedMemberId, startupId], references: [id, startupId], onDelete: Cascade)
  investor        StartupInvestor?  @relation(fields: [investorId, startupId], references: [id, startupId], onDelete: Cascade)
  pipeline        Pipeline?         @relation(fields: [pipelineId, startupId], references: [id, startupId], onDelete: Cascade)
  task            Task?             @relation(fields: [taskId, startupId], references: [id, startupId], onDelete: Cascade)
  round           FundraisingRound? @relation(fields: [roundId, startupId], references: [id, startupId], onDelete: Cascade)
  document        Document?         @relation(fields: [documentId, startupId], references: [id, startupId], onDelete: Cascade)

  @@index([startupId, targetType, pipelineId, createdAt])
  @@index([startupId, targetType, investorId, createdAt])
  @@index([startupId, targetType, taskId, createdAt])
  @@index([startupId, targetType, roundId, createdAt])
  @@index([startupId, targetType, documentId, createdAt])
  @@index([startupId, mentionedMemberId, createdAt])
  @@index([messageId])
  @@map("message_mentions")
}

// ─── PLATFORM ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  startupId  String   @map("startup_id")
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([startupId, entityType, entityId])
  @@index([startupId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(uuid())
  startupId  String    @map("startup_id")
  userId     String    @map("user_id")
  type       String
  title      String
  body       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([startupId, createdAt])
  @@map("notifications")
}
