generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── CORE ─────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  // How this person signs off outbound investor communications (e.g. "Co-Founder
  // & CEO") — the AI copilot uses it to fill a real signature instead of a
  // "[Your Position]" placeholder when drafting an email.
  title               String?
  email               String    @unique
  passwordHash        String?   @map("password_hash")
  avatarUrl           String?   @map("avatar_url")
  avatarStorageKey    String?   @map("avatar_storage_key")
  authProvider        String    @default("local") @map("auth_provider")
  googleId            String?   @unique @map("google_id")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastActiveStartupId String?   @map("last_active_startup_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  lastActiveStartup      Startup?                @relation("LastActiveStartup", fields: [lastActiveStartupId], references: [id])
  createdStartups        Startup[]               @relation("CreatedStartups")
  memberships            StartupMember[]         @relation("MemberUser")
  sentInvites            StartupMember[]         @relation("InvitedBy")
  refreshTokens          RefreshToken[]
  passwordResets         PasswordReset[]
  reviewerInvitations    ReviewerInvitation[]
  interactionLogs        InteractionLog[]
  createdDocuments       Document[]
  uploadedVersions       DocumentVersion[]
  aiChatSessions         AiChatSession[]
  requestedAiAnalyses    AiAnalysis[]            @relation("AiAnalysisRequester")
  aiRuns                 AiRun[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  pipelineStageEvents    PipelineStageEvent[]
  tasks                  Task[]
  authoredInvestorNotes  StartupInvestor[]       @relation("InvestorNotesAuthor")
  editedInvestorNotes    StartupInvestor[]       @relation("InvestorNotesEditor")
  commitmentStatusEvents CommitmentStatusEvent[]
  googleConnection       GoogleConnection?
  conversationsCreated   Conversation[]
  aiAgentActions         AiAgentAction[]

  @@map("users")
}

// ─── INTEGRATIONS ─────────────────────────────────────────────────────────────

model GoogleConnection {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // The Google account actually connected may differ from the sign-in email.
  googleEmail String @map("google_email")

  // OAuth scopes granted at consent time, e.g. "calendar.events gmail.send".
  scopes String @map("scopes")

  // AES-256-GCM ciphertext (iv + auth tag + ciphertext, base64) never the raw token.
  refreshTokenCipher String @map("refresh_token_cipher")

  status String @default("active")

  calendarSyncEnabled Boolean @default(true) @map("calendar_sync_enabled")

  // Calendar's incremental sync cursor. Null forces a full resync.
  calendarSyncToken String?   @map("calendar_sync_token")
  lastSyncedAt      DateTime? @map("last_synced_at")
  lastError         String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_connections")
}

model Startup {
  id           String   @id @default(uuid())
  name         String
  description  String?
  industry     String?
  website      String?
  fundingStage String?  @map("funding_stage")
  // Structured comparables so the copilot can judge investor/pitch fit without
  // re-deriving them from free-text description every time.
  oneLiner         String?   @map("one_liner")
  problemStatement String?   @map("problem_statement")
  solutionSummary  String?   @map("solution_summary")
  targetMarket     String?   @map("target_market")
  businessModel    String?   @map("business_model")
  tractionSummary  String?   @map("traction_summary")
  competitiveEdge  String?   @map("competitive_edge")
  headquarters     String?
  foundedAt        DateTime? @map("founded_at")
  teamSummary      String?   @map("team_summary")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator                User                    @relation("CreatedStartups", fields: [createdBy], references: [id])
  lastActiveUsers        User[]                  @relation("LastActiveStartup")
  members                StartupMember[]
  roles                  Role[]
  startupInvestors       StartupInvestor[]
  pipeline               Pipeline[]
  fundraisingRounds      FundraisingRound[]
  commitments            Commitment[]
  commitmentStatusEvents CommitmentStatusEvent[]
  documents              Document[]
  aiAnalyses             AiAnalysis[]
  aiChatSessions         AiChatSession[]
  aiRuns                 AiRun[]
  aiArtifacts            AiArtifact[]
  aiAgentActions         AiAgentAction[]
  reviewerInvitations    ReviewerInvitation[]
  reviewerComments       ReviewerComment[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  pipelineStageEvents    PipelineStageEvent[]
  tasks                  Task[]
  conversations          Conversation[]
  conversationMembers    ConversationMember[]
  messages               Message[]
  messageMentions        MessageMention[]
  messageReactions       MessageReaction[]
  messageAttachments     MessageAttachment[]

  @@map("startups")
}

model StartupMember {
  id              String    @id @default(uuid())
  startupId       String    @map("startup_id")
  userId          String?   @map("user_id")
  roleId          String    @map("role_id")
  status          String    @default("pending")
  invitedEmail    String?   @map("invited_email")
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  invitedBy       String?   @map("invited_by")
  joinedAt        DateTime? @map("joined_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User?   @relation("MemberUser", fields: [userId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])
  inviter User?   @relation("InvitedBy", fields: [invitedBy], references: [id])

  ownedDeals    Pipeline[] @relation("PipelineOwner")
  assignedTasks Task[]     @relation("TaskAssignee")

  conversationMemberships ConversationMember[]
  messagesSent            Message[]            @relation("MessageSender")
  chatMentions            MessageMention[]     @relation("MentionedMember")
  messageReactions        MessageReaction[]

  @@unique([startupId, userId])
  @@unique([startupId, invitedEmail])
  @@unique([startupId, id])
  @@map("startup_members")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model PendingRegistration {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  otpHash      String   @map("otp_hash")
  otpExpiresAt DateTime @map("otp_expires_at")
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String?   @map("family_id")
  replacedById String?   @map("replaced_by_id")
  deviceInfo   String?   @map("device_info")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy     RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replacedTokens RefreshToken[] @relation("TokenRotation")

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id           String   @id @default(uuid())
  startupId    String   @map("startup_id")
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  startup         Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  members         StartupMember[]
  rolePermissions RolePermission[]

  @@unique([startupId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── REVIEWER SYSTEM ──────────────────────────────────────────────────────────

model ReviewerInvitation {
  id                  String    @id @default(uuid())
  startupId           String    @map("startup_id")
  startupInvestorId   String?   @map("startup_investor_id")
  reviewerName        String?   @map("reviewer_name")
  emailNormalized     String    @map("email_normalized")
  tokenHash           String    @unique @map("token_hash")
  /// pending | opened | in_review | completed | revoked
  status              String    @default("pending")
  allowDownload       Boolean   @default(false) @map("allow_download")
  watermarkEnabled    Boolean   @default(true) @map("watermark_enabled")
  notifyOnOpen        Boolean   @default(true) @map("notify_on_open")
  allowPrint          Boolean   @default(false) @map("allow_print")
  screenshotGuard     Boolean   @default(true) @map("screenshot_guard")
  requireNda          Boolean   @default(false) @map("require_nda")
  ndaText             String?   @map("nda_text")
  ndaAcceptedAt       DateTime? @map("nda_accepted_at")
  passwordHash        String?   @map("password_hash")
  allowedEmailDomains String[]  @default([]) @map("allowed_email_domains")
  personalMessage     String?   @map("personal_message")
  expiresAt           DateTime  @map("expires_at")
  completedAt         DateTime? @map("completed_at")
  revokedAt           DateTime? @map("revoked_at")
  lastActivityAt      DateTime? @map("last_activity_at")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  startup         Startup                      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupInvestor StartupInvestor?             @relation(fields: [startupInvestorId], references: [id])
  creator         User                         @relation(fields: [createdBy], references: [id])
  documents       ReviewerInvitationDocument[]
  sessions        ReviewerSession[]
  events          ReviewerEvent[]
  visits          ReviewerVisit[]

  @@unique([startupId, id])
  @@index([startupId, status])
  @@index([startupId, emailNormalized])
  @@index([startupId, expiresAt])
  @@map("reviewer_invitations")
}

model ReviewerInvitationDocument {
  id                String   @id @default(uuid())
  invitationId      String   @map("invitation_id")
  documentId        String   @map("document_id")
  documentVersionId String   @map("document_version_id")
  displayOrder      Int      @default(0) @map("display_order")
  addedAt           DateTime @default(now()) @map("added_at")
  addedBy           String   @map("added_by")

  invitation      ReviewerInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  document        Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([invitationId, documentVersionId])
  @@map("reviewer_invitation_documents")
}

model ReviewerSession {
  id                    String    @id @default(uuid())
  invitationId          String    @map("invitation_id")
  /// Opaque session cookie token hash (set after OTP verification).
  sessionTokenHash      String?   @unique @map("session_token_hash")
  verificationCodeHash  String?   @map("verification_code_hash")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  verifiedAt            DateTime? @map("verified_at")
  accessedAt            DateTime? @map("accessed_at")
  expiresAt             DateTime? @map("expires_at")
  revokedAt             DateTime? @map("revoked_at")
  ipAddress             String?   @map("ip_address")
  userAgent             String?   @map("user_agent")
  createdAt             DateTime  @default(now()) @map("created_at")

  invitation ReviewerInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  comments   ReviewerComment[]

  @@index([invitationId])
  @@map("reviewer_sessions")
}

model ReviewerComment {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  startupId   String   @map("startup_id")
  documentId  String?  @map("document_id")
  chunkId     String?  @map("chunk_id")
  commentText String   @map("comment_text")
  createdAt   DateTime @default(now()) @map("created_at")

  session  ReviewerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startup  Startup         @relation(fields: [startupId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id])
  chunk    DocumentChunk?  @relation(fields: [chunkId], references: [id])

  @@map("reviewer_comments")
}

model ReviewerEvent {
  id                String   @id @default(uuid())
  startupId         String   @map("startup_id")
  invitationId      String   @map("invitation_id")
  sessionId         String   @map("session_id")
  /// copy_attempt | print_attempt | screenshot_attempt
  type              String
  documentVersionId String?  @map("document_version_id")
  pageNumber        Int?     @map("page_number")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  invitation ReviewerInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
  @@index([startupId, type, createdAt])
  @@map("reviewer_events")
}

model ReviewerVisit {
  id               String    @id @default(uuid())
  startupId        String    @map("startup_id")
  invitationId     String    @map("invitation_id")
  sessionId        String    @unique @map("session_id")
  startedAt        DateTime  @default(now()) @map("started_at")
  lastSeenAt       DateTime  @map("last_seen_at")
  endedAt          DateTime? @map("ended_at")
  totalActiveMs    Int       @default(0) @map("total_active_ms")
  pagesViewed      Int       @default(0) @map("pages_viewed")
  maxPageReached   Int       @default(0) @map("max_page_reached")
  completionPct    Int       @default(0) @map("completion_pct")
  deviceType       String?   @map("device_type")
  os               String?   @map("os")
  browser          String?   @map("browser")
  deviceHash       String?   @map("device_hash")
  ipHash           String?   @map("ip_hash")
  referrer         String?   @map("referrer")
  suspectedForward Boolean   @default(false) @map("suspected_forward")

  invitation ReviewerInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  pageViews  ReviewerPageView[]

  @@index([invitationId, startedAt])
  @@index([startupId, startedAt])
  @@map("reviewer_visits")
}

model ReviewerPageView {
  id                String   @id @default(uuid())
  visitId           String   @map("visit_id")
  documentVersionId String   @map("document_version_id")
  pageNumber        Int      @map("page_number")
  firstViewedAt     DateTime @map("first_viewed_at")
  lastViewedAt      DateTime @map("last_viewed_at")
  activeMs          Int      @default(0) @map("active_ms")
  viewCount         Int      @default(1) @map("view_count")

  visit ReviewerVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, documentVersionId, pageNumber])
  @@index([documentVersionId, pageNumber])
  @@map("reviewer_page_views")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model StartupInvestor {
  id                        String    @id @default(uuid())
  startupId                 String    @map("startup_id")
  fullName                  String    @map("full_name")
  email                     String?
  ventureFirm               String?   @map("venture_firm")
  investorType              String?   @map("investor_type")
  sectorFocus               String?   @map("sector_focus")
  investmentStagePreference String?   @map("investment_stage_preference")
  linkedinUrl               String?   @map("linkedin_url")
  // The stable "who is this investor" profile — separate from `notes`, which is a
  // running human scratchpad that churns and is often stale. Collapsing the two
  // would make the model quote a two-month-old scratch note as if it were a fact.
  description         String?   @map("description")
  checkSizeMin        Decimal?  @map("check_size_min")
  checkSizeMax        Decimal?  @map("check_size_max")
  geographyFocus      String?   @map("geography_focus")
  portfolioHighlights String?   @map("portfolio_highlights")
  warmIntroPath       String?   @map("warm_intro_path")
  notes                     String?
  notesCreatedAt            DateTime? @map("notes_created_at")
  notesCreatedBy            String?   @map("notes_created_by")
  notesUpdatedAt            DateTime? @map("notes_updated_at")
  notesUpdatedBy            String?   @map("notes_updated_by")
  source                    String?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  startup             Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  notesAuthor         User?                @relation("InvestorNotesAuthor", fields: [notesCreatedBy], references: [id], onDelete: SetNull)
  notesEditor         User?                @relation("InvestorNotesEditor", fields: [notesUpdatedBy], references: [id], onDelete: SetNull)
  pipeline            Pipeline[]           @relation("PipelineInvestor")
  interactionLogs     InteractionLog[]
  commitments         Commitment[]         @relation("CommitmentInvestor")
  reviewerInvitations ReviewerInvitation[]
  mentions            MessageMention[]

  @@unique([startupId, email])
  @@unique([startupId, id])
  @@map("startup_investors")
}

model Pipeline {
  id                    String   @id @default(uuid())
  startupId             String   @map("startup_id")
  roundId               String   @map("round_id")
  startupInvestorId     String   @map("startup_investor_id")
  stage                 String   @default("sourced")
  expectedAmount        Decimal? @map("expected_amount")
  probabilityPercentage Int?     @map("probability_percentage")
  ownerId               String?  @map("owner_id")
  priority              String?
  investorFitScore      Int?     @map("investor_fit_score")
  isLead                Boolean  @default(false) @map("is_lead")
  sortOrder             Float    @default(0) @map("sort_order")
  stageChangedAt        DateTime @default(now()) @map("stage_changed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  startup         Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  round           FundraisingRound     @relation("PipelineRound", fields: [roundId, startupId], references: [id, startupId], onDelete: Restrict)
  startupInvestor StartupInvestor      @relation("PipelineInvestor", fields: [startupInvestorId, startupId], references: [id, startupId], onDelete: Cascade)
  owner           StartupMember?       @relation("PipelineOwner", fields: [ownerId, startupId], references: [id, startupId], onDelete: NoAction)
  interactionLogs InteractionLog[]
  commitments     Commitment[]         @relation("CommitmentPipeline")
  stageEvents     PipelineStageEvent[]
  tasks           Task[]
  mentions        MessageMention[]

  @@unique([roundId, startupInvestorId])
  @@unique([id, startupInvestorId])
  @@unique([id, startupInvestorId, roundId])
  @@unique([startupId, id])
  @@index([startupId, roundId, stage, sortOrder])
  @@index([startupId, roundId, stageChangedAt])
  @@map("pipeline")
}

model PipelineStageEvent {
  id         String   @id @default(uuid())
  startupId  String   @map("startup_id")
  roundId    String   @map("round_id")
  pipelineId String   @map("pipeline_id")
  fromStage  String?  @map("from_stage")
  toStage    String   @map("to_stage")
  reason     String?
  changedBy  String?  @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  startup  Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  round    FundraisingRound @relation("PipelineStageEventRound", fields: [roundId, startupId], references: [id, startupId], onDelete: Restrict)
  pipeline Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  actor    User?            @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([startupId, createdAt])
  @@index([startupId, roundId, createdAt])
  @@index([pipelineId, createdAt])
  @@map("pipeline_stage_events")
}

model Task {
  id          String    @id @default(uuid())
  startupId   String    @map("startup_id")
  pipelineId  String    @map("pipeline_id")
  title       String
  description String?
  status      String    @default("open")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date")
  assigneeId  String?   @map("assignee_id")
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  startup  Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  pipeline Pipeline         @relation(fields: [pipelineId, startupId], references: [id, startupId], onDelete: Restrict)
  assignee StartupMember?   @relation("TaskAssignee", fields: [assigneeId, startupId], references: [id, startupId], onDelete: NoAction)
  creator  User             @relation(fields: [createdBy], references: [id])
  mentions MessageMention[]

  @@unique([startupId, id])
  @@index([startupId, pipelineId, status])
  @@index([startupId, status, dueDate])
  @@map("tasks")
}

model InteractionLog {
  id                  String    @id @default(uuid())
  startupInvestorId   String    @map("startup_investor_id")
  pipelineId          String?   @map("pipeline_id")
  createdBy           String    @map("created_by")
  type                String
  subject             String?
  description         String?
  interactionDate     DateTime? @map("interaction_date")
  nextFollowupDate    DateTime? @map("next_followup_date")
  followupCompletedAt DateTime? @map("followup_completed_at")
  source              String    @default("manual")
  externalId          String?   @map("external_id")
  gmailThreadId       String?   @map("gmail_thread_id")
  emailMessageId      String?   @map("email_message_id")
  editedByUser        Boolean   @default(false) @map("edited_by_user")

  createdAt DateTime @default(now()) @map("created_at")

  startupInvestor StartupInvestor @relation(fields: [startupInvestorId], references: [id], onDelete: Cascade)
  pipeline        Pipeline?       @relation(fields: [pipelineId, startupInvestorId], references: [id, startupInvestorId])
  creator         User            @relation(fields: [createdBy], references: [id])

  @@unique([startupInvestorId, externalId])
  @@map("interaction_logs")
}

// ─── FINANCIAL ────────────────────────────────────────────────────────────────

model FundraisingRound {
  id                      String    @id @default(uuid())
  startupId               String    @map("startup_id")
  roundName               String    @map("round_name")
  targetAmount            Decimal?  @map("target_amount")
  minimumTicketSize       Decimal?  @map("minimum_ticket_size")
  equityOfferedPercentage Decimal?  @map("equity_offered_percentage")
  currency                String    @default("USD")
  status                  String    @default("active")
  firstCloseDate          DateTime? @map("first_close_date")
  targetCloseDate         DateTime? @map("target_close_date")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  startup             Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  pipeline            Pipeline[]           @relation("PipelineRound")
  pipelineStageEvents PipelineStageEvent[] @relation("PipelineStageEventRound")
  commitments         Commitment[]         @relation("CommitmentRound")
  mentions            MessageMention[]
  aiChatSessions      AiChatSession[]

  @@unique([startupId, id])
  @@map("fundraising_rounds")
}

model Commitment {
  id                String    @id @default(uuid())
  startupId         String    @map("startup_id")
  startupInvestorId String    @map("startup_investor_id")
  pipelineId        String    @map("pipeline_id")
  roundId           String    @map("round_id")
  amount            Decimal?
  status            String    @default("soft_circled")
  expectedCloseDate DateTime? @map("expected_close_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  startup         Startup                 @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupInvestor StartupInvestor         @relation("CommitmentInvestor", fields: [startupInvestorId, startupId], references: [id, startupId], onDelete: Cascade)
  pipeline        Pipeline                @relation("CommitmentPipeline", fields: [pipelineId, startupInvestorId, roundId], references: [id, startupInvestorId, roundId])
  round           FundraisingRound        @relation("CommitmentRound", fields: [roundId, startupId], references: [id, startupId])
  statusEvents    CommitmentStatusEvent[]

  @@index([startupId, roundId, status])
  @@map("commitments")
}

model CommitmentStatusEvent {
  id           String   @id @default(uuid())
  startupId    String   @map("startup_id")
  commitmentId String   @map("commitment_id")
  // Null for the first event the commitment being recorded.
  fromStatus   String?  @map("from_status")
  toStatus     String   @map("to_status")
  changedBy    String?  @map("changed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  startup    Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([startupId, createdAt])
  @@index([commitmentId, createdAt])
  @@map("commitment_status_events")
}

// ─── DOCUMENT VAULT ───────────────────────────────────────────────────────────

model Document {
  id           String   @id @default(uuid())
  startupId    String   @map("startup_id")
  title        String
  documentType String   @map("document_type")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  startup                Startup                      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  creator                User                         @relation(fields: [createdBy], references: [id])
  versions               DocumentVersion[]
  reviewerDocs           ReviewerInvitationDocument[]
  reviewerComments       ReviewerComment[]
  aiChatSessionDocuments AiChatSessionDocument[]
  mentions               MessageMention[]
  messageAttachments     MessageAttachment[]

  @@unique([startupId, id])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String   @map("document_id")
  versionNumber    Int      @map("version_number")
  isCurrent        Boolean  @default(false) @map("is_current")
  /// Legacy public-style URL; prefer storageKey + signed URLs.
  fileUrl          String?  @map("file_url")
  storageProvider  String   @default("local") @map("storage_provider")
  storageKey       String   @map("storage_key")
  mimeType         String   @map("mime_type")
  originalFilename String   @map("original_filename")
  checksumSha256   String?  @map("checksum_sha256")
  fileSize         Int?     @map("file_size")
  /// pending_upload | processing | ready | failed
  processingStatus String   @default("pending_upload") @map("processing_status")
  processingError  String?  @map("processing_error")
  renderStatus     String   @default("pending") @map("render_status")
  renderError      String?  @map("render_error")
  pageCount        Int?     @map("page_count")
  summary          String?
  uploadedBy       String   @map("uploaded_by")
  createdAt        DateTime @default(now()) @map("created_at")

  document                    Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader                    User                         @relation(fields: [uploadedBy], references: [id])
  chunks                      DocumentChunk[]
  pages                       DocumentPage[]
  aiAnalyses                  AiAnalysis[]
  aiChatSessionDocuments      AiChatSessionDocument[]
  reviewerInvitationDocuments ReviewerInvitationDocument[]

  @@unique([documentId, versionNumber])
  @@unique([documentId, id])
  @@map("document_versions")
}

model DocumentPage {
  id                String   @id @default(uuid())
  documentVersionId String   @map("document_version_id")
  pageNumber        Int      @map("page_number")
  width             Int
  height            Int
  storageKey        String   @map("storage_key")
  thumbStorageKey   String   @map("thumb_storage_key")
  storageProvider   String   @default("local") @map("storage_provider")
  byteSize          Int?     @map("byte_size")
  createdAt         DateTime @default(now()) @map("created_at")

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, pageNumber])
  @@map("document_pages")
}

model DocumentChunk {
  id                String                       @id @default(uuid())
  documentVersionId String                       @map("document_version_id")
  chunkIndex        Int                          @map("chunk_index")
  content           String
  embedding         Unsupported("vector(1536)")?
  tokenCount        Int?                         @map("token_count")
  pageNumber        Int?                         @map("page_number")
  sectionLabel      String?                      @map("section_label")
  charStart         Int?                         @map("char_start")
  charEnd           Int?                         @map("char_end")
  createdAt         DateTime                     @default(now()) @map("created_at")

  documentVersion    DocumentVersion      @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  reviewerComments   ReviewerComment[]
  aiAnalysisEvidence AiAnalysisEvidence[]

  @@unique([documentVersionId, chunkIndex])
  @@map("document_chunks")
}

// ─── AI INSIGHTS ──────────────────────────────────────────────────────────────

model AiAnalysis {
  id                    String    @id @default(uuid())
  startupId             String    @map("startup_id")
  documentVersionId     String    @map("document_version_id")
  overallScore          Int?      @map("overall_score")
  narrativeScore        Int?      @map("narrative_score")
  marketValidationScore Int?      @map("market_validation_score")
  financialScore        Int?      @map("financial_score")
  summaryReport         String?   @map("summary_report")
  sessionId             String?   @map("session_id")
  requestedBy           String    @map("requested_by")
  analysisType          String    @default("pitch_deck") @map("analysis_type")
  schemaVersion         String    @default("pitch-deck.v1") @map("schema_version")
  rubricVersion         String    @default("pitch-deck.v1") @map("rubric_version")
  model                 String?
  confidenceScore       Int?      @map("confidence_score")
  result                Json?
  status                String    @default("queued")
  queuedAt              DateTime  @default(now()) @map("queued_at")
  startedAt             DateTime? @map("started_at")
  completedAt           DateTime? @map("completed_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  errorCode             String?   @map("error_code")
  errorMessage          String?   @map("error_message")
  createdAt             DateTime  @default(now()) @map("created_at")

  startup         Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion      @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  session         AiChatSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  requester       User                 @relation("AiAnalysisRequester", fields: [requestedBy], references: [id])
  gapAnalyses     AiGapAnalysis[]
  personas        InvestorPersona[]
  evidence        AiAnalysisEvidence[]
  artifacts       AiArtifact[]
  runs            AiRun[]

  @@unique([startupId, id])
  @@index([startupId, documentVersionId, createdAt])
  @@index([startupId, sessionId, createdAt])
  @@index([startupId, status, createdAt])
  @@map("ai_analyses")
}

model AiGapAnalysis {
  id             String  @id @default(uuid())
  analysisId     String  @map("analysis_id")
  sectionName    String? @map("section_name")
  status         String
  issue          String?
  recommendation String?
  severity       String?

  analysis AiAnalysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidence AiAnalysisEvidence[]

  @@map("ai_gap_analysis")
}

model InvestorPersona {
  id          String  @id @default(uuid())
  analysisId  String  @map("analysis_id")
  personaName String? @map("persona_name")
  description String?

  analysis  AiAnalysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questions PersonaQuestion[]
  sessions  AiChatSession[]   @relation("AiSessionPersona")

  @@map("investor_personas")
}

model PersonaQuestion {
  id           String  @id @default(uuid())
  personaId    String  @map("persona_id")
  questionText String? @map("question_text")

  persona InvestorPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@map("persona_questions")
}

// ─── AI CHAT ──────────────────────────────────────────────────────────────────

model AiChatSession {
  id            String    @id @default(uuid())
  startupId     String    @map("startup_id")
  userId        String    @map("user_id")
  title         String?
  roundId       String?   @map("round_id")
  personaId     String?   @map("persona_id")
  contextMode   String    @default("selected") @map("context_mode")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  startup   Startup                 @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id])
  round     FundraisingRound?       @relation(fields: [roundId, startupId], references: [id, startupId], onDelete: Restrict)
  persona   InvestorPersona?        @relation("AiSessionPersona", fields: [personaId], references: [id], onDelete: SetNull)
  messages  AiChatMessage[]
  documents AiChatSessionDocument[]
  analyses  AiAnalysis[]
  artifacts AiArtifact[]
  runs      AiRun[]
  agentActions AiAgentAction[]

  @@unique([startupId, id])
  @@index([startupId, userId, archivedAt, lastMessageAt])
  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id                  String    @id @default(uuid())
  sessionId           String    @map("session_id")
  clientRequestId     String?   @map("client_request_id")
  responseToMessageId String?   @unique @map("response_to_message_id")
  role                String
  content             String
  status              String    @default("completed")
  model               String?
  structuredContent   Json?     @map("structured_content")
  errorCode           String?   @map("error_code")
  errorMessage        String?   @map("error_message")
  inputTokens         Int?      @map("input_tokens")
  outputTokens        Int?      @map("output_tokens")
  timeToFirstTokenMs  Int?      @map("time_to_first_token_ms")
  retrievalResultCount Int?     @map("retrieval_result_count")
  retrievalMinScore   Float?    @map("retrieval_min_score")
  retrievalMaxScore   Float?    @map("retrieval_max_score")
  latencyMs           Int?      @map("latency_ms")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  citations AiCitation[]
  toolCalls AiToolCall[]
  artifacts AiArtifact[]
  runs      AiRun[]
  agentActions AiAgentAction[]

  @@unique([sessionId, clientRequestId])
  @@index([sessionId, createdAt])
  @@map("ai_chat_messages")
}

model AiAgentAction {
  id              String    @id @default(uuid())
  startupId       String    @map("startup_id")
  sessionId       String    @map("session_id")
  messageId       String    @map("message_id")
  userId          String    @map("user_id") // who it will act as
  actionType      String    @map("action_type") // send_investor_email | schedule_meeting | create_task | log_interaction | update_deal_stage
  status          String    @default("proposed") @map("status") // proposed | approved | executed | rejected | failed | expired
  payload         Json // model-proposed, zod-validated
  resolvedPayload Json?     @map("resolved_payload") // what was actually executed, after any user edit
  resultRef       Json?     @map("result_ref") // { taskId } | { logId } | { gmailMessageId, gmailThreadId } | { eventId, htmlLink } | { pipelineId, stage }
  errorCode       String?   @map("error_code")
  approvedAt      DateTime? @map("approved_at")
  executedAt      DateTime? @map("executed_at")
  // A stale proposal in an old conversation cannot be approved next week
  // against data that has since moved defaults to +24h from creation.
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  startup Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])

  @@index([startupId, status, createdAt])
  @@index([messageId])
  @@map("ai_agent_actions")
}

model AiChatSessionDocument {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  documentId        String   @map("document_id")
  documentVersionId String   @map("document_version_id")
  createdAt         DateTime @default(now()) @map("created_at")

  session         AiChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, documentVersionId])
  @@index([documentId])
  @@map("ai_chat_session_documents")
}

model AiCitation {
  id              String   @id @default(uuid())
  messageId       String   @map("message_id")
  sourceType      String   @map("source_type")
  sourceId        String   @map("source_id")
  documentChunkId String?  @map("document_chunk_id")
  label           String
  excerpt         String?
  metadata        Json?
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  message AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, sortOrder])
  @@map("ai_citations")
}

model AiToolCall {
  id            String   @id @default(uuid())
  messageId     String   @map("message_id")
  toolName      String   @map("tool_name")
  arguments     Json
  status        String
  durationMs    Int?     @map("duration_ms")
  errorCode     String?  @map("error_code")
  resultSummary Json?    @map("result_summary")
  createdAt     DateTime @default(now()) @map("created_at")

  message AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("ai_tool_calls")
}

model AiRun {
  id                  String    @id @default(uuid())
  startupId           String    @map("startup_id")
  userId              String    @map("user_id")
  sessionId           String?   @map("session_id")
  messageId           String?   @map("message_id")
  analysisId          String?   @map("analysis_id")
  operationType       String    @map("operation_type")
  provider            String
  model               String
  providerRequestId   String?   @map("provider_request_id")
  status              String    @default("started")
  inputTokens         Int?      @map("input_tokens")
  cachedInputTokens   Int?      @map("cached_input_tokens")
  outputTokens        Int?      @map("output_tokens")
  latencyMs           Int?      @map("latency_ms")
  estimatedCostMicros BigInt?   @map("estimated_cost_micros")
  errorCode           String?   @map("error_code")
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  startup  Startup        @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id])
  session  AiChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  message  AiChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  analysis AiAnalysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([startupId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([analysisId, createdAt])
  @@index([status, createdAt])
  @@map("ai_runs")
}

model AiAnalysisEvidence {
  id              String   @id @default(uuid())
  analysisId      String   @map("analysis_id")
  gapAnalysisId   String?  @map("gap_analysis_id")
  documentChunkId String   @map("document_chunk_id")
  evidenceType    String   @map("evidence_type")
  label           String
  excerpt         String?
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  analysis      AiAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  gapAnalysis   AiGapAnalysis? @relation(fields: [gapAnalysisId], references: [id], onDelete: Cascade)
  documentChunk DocumentChunk  @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@index([analysisId, sortOrder])
  @@index([documentChunkId])
  @@map("ai_analysis_evidence")
}

model AiArtifact {
  id            String   @id @default(uuid())
  startupId     String   @map("startup_id")
  sessionId     String   @map("session_id")
  messageId     String   @map("message_id")
  analysisId    String?  @map("analysis_id")
  artifactType  String   @map("artifact_type")
  schemaVersion String   @map("schema_version")
  title         String?
  status        String   @default("building")
  data          Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  startup  Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  session  AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message  AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  analysis AiAnalysis?   @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([startupId, sessionId, createdAt])
  @@index([messageId, createdAt])
  @@index([analysisId, createdAt])
  @@map("ai_artifacts")
}

// ─── TEAM CHAT ────────────────────────────────────────────────────────────────
model Conversation {
  id            String    @id @default(uuid())
  startupId     String    @map("startup_id")
  type          String    @default("channel")
  name          String?
  topic         String?
  dmKey         String?   @map("dm_key")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  startup  Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  creator  User                 @relation(fields: [createdBy], references: [id])
  members  ConversationMember[]
  messages Message[]
  mentions MessageMention[]

  @@unique([startupId, id])
  @@unique([startupId, name])
  @@unique([startupId, dmKey])
  @@index([startupId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(uuid())
  startupId      String   @map("startup_id")
  conversationId String   @map("conversation_id")
  memberId       String   @map("member_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  lastReadSeq BigInt?   @map("last_read_seq")
  lastReadAt  DateTime? @map("last_read_at")

  notifyLevel String @default("all") @map("notify_level")

  conversation Conversation  @relation(fields: [conversationId, startupId], references: [id, startupId], onDelete: Cascade)
  member       StartupMember @relation(fields: [memberId, startupId], references: [id, startupId], onDelete: Cascade)
  startup      Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId, startupId])
  @@map("conversation_members")
}

model Message {
  id              String  @id @default(uuid())
  startupId       String  @map("startup_id")
  conversationId  String  @map("conversation_id")
  seq             BigInt  @default(autoincrement())
  senderId        String? @map("sender_id")
  parentMessageId String? @map("parent_message_id")
  replyCount      Int     @default(0) @map("reply_count")

  body String

  clientNonce String    @map("client_nonce")
  editedAt    DateTime? @map("edited_at")
  deletedAt   DateTime? @map("deleted_at") // tombstone, never a hard delete
  createdAt   DateTime  @default(now()) @map("created_at")

  startup      Startup             @relation(fields: [startupId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId, startupId], references: [id, startupId], onDelete: Cascade)
  sender       StartupMember?      @relation("MessageSender", fields: [senderId, startupId], references: [id, startupId], onDelete: NoAction)
  parent       Message?            @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies      Message[]           @relation("MessageReplies")
  mentions     MessageMention[]
  reactions    MessageReaction[]
  attachments  MessageAttachment[]

  @@unique([startupId, id])
  @@unique([conversationId, clientNonce])
  @@index([conversationId, seq])
  @@index([parentMessageId, seq])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  startupId String   @map("startup_id")
  messageId String   @map("message_id")
  memberId  String   @map("member_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  member StartupMember @relation(fields: [memberId, startupId], references: [id, startupId], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageAttachment {
  id         String   @id @default(uuid())
  startupId  String   @map("startup_id")
  messageId  String   @map("message_id")
  documentId String   @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  startup  Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId, startupId], references: [id, startupId], onDelete: Cascade)

  @@unique([messageId, documentId])
  @@index([messageId])
  @@map("message_attachments")
}

model MessageMention {
  id             String @id @default(uuid())
  startupId      String @map("startup_id")
  messageId      String @map("message_id")
  conversationId String @map("conversation_id") // denormalized: backlinks skip a join through Message

  // "member" | "investor" | "deal" | "task" | "round" | "document"
  targetType String @map("target_type")

  mentionedMemberId String? @map("mentioned_member_id")
  investorId        String? @map("investor_id")
  pipelineId        String? @map("pipeline_id")
  taskId            String? @map("task_id")
  roundId           String? @map("round_id")
  documentId        String? @map("document_id")

  createdAt DateTime @default(now()) @map("created_at")

  startup         Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  message         Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation    Conversation      @relation(fields: [conversationId, startupId], references: [id, startupId], onDelete: Cascade)
  mentionedMember StartupMember?    @relation("MentionedMember", fields: [mentionedMemberId, startupId], references: [id, startupId], onDelete: Cascade)
  investor        StartupInvestor?  @relation(fields: [investorId, startupId], references: [id, startupId], onDelete: Cascade)
  pipeline        Pipeline?         @relation(fields: [pipelineId, startupId], references: [id, startupId], onDelete: Cascade)
  task            Task?             @relation(fields: [taskId, startupId], references: [id, startupId], onDelete: Cascade)
  round           FundraisingRound? @relation(fields: [roundId, startupId], references: [id, startupId], onDelete: Cascade)
  document        Document?         @relation(fields: [documentId, startupId], references: [id, startupId], onDelete: Cascade)

  @@index([startupId, targetType, pipelineId, createdAt])
  @@index([startupId, targetType, investorId, createdAt])
  @@index([startupId, targetType, taskId, createdAt])
  @@index([startupId, targetType, roundId, createdAt])
  @@index([startupId, targetType, documentId, createdAt])
  @@index([startupId, mentionedMemberId, createdAt])
  @@index([messageId])
  @@map("message_mentions")
}

// ─── PLATFORM ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  startupId  String   @map("startup_id")
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([startupId, entityType, entityId])
  @@index([startupId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(uuid())
  startupId  String    @map("startup_id")
  userId     String    @map("user_id")
  type       String
  title      String
  body       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([startupId, createdAt])
  @@index([userId, startupId, readAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId, type, createdAt])
  @@map("notifications")
}
